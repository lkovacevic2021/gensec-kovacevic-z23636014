# Required: Google Cloud project and Vertex AI Gemini model.
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Optional: Vertex AI location (defaults to us-west1).
GOOGLE_CLOUD_LOCATION=us-west1

# Optional: NVD API key for higher CVE lookup rate limits.
NVD_API_KEY=